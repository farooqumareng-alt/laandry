{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/orders/:id", "destination": "/orders/%5Bid%5D" },
    { "source": "/provider/orders/:id", "destination": "/provider/orders/%5Bid%5D" },
    { "source": "/services/:slug", "destination": "/services/%5Bslug%5D" }
  ]
}
