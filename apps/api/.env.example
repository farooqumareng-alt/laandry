NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://laandry:laandry@localhost:5432/laandry?schema=public"

# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-random-64-char-hex-string-before-any-real-deploy"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated — the exact origins the web app / admin console are served from.
# No wildcard in production: an empty/wrong allowlist fails safe (CORS blocks), a wildcard doesn't.
CORS_ORIGINS="http://localhost:8081,http://localhost:3000,http://localhost:3001"
