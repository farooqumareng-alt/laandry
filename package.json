{
  "name": "laandry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm run build:packages",
    "build:packages": "npm run build -w packages/domain -w packages/ui -w packages/api-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start": "npm run dev",
    "dev": "concurrently -n api,app,admin -c blue,green,magenta \"npm:dev:api\" \"npm:dev:app\" \"npm:dev:admin\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:app": "npm run dev --workspace apps/app",
    "dev:admin": "npm run dev --workspace apps/admin"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
